# Output map template. Copy to profiles/<name>/.env.outputs (a local file).
# Each key is a generated-artifact kind. Its value is the directory where agents write that kind.
# Values are paths. ~ is expanded at runtime.
#
# You can add a line for any other kind, when you want those generated files stored
# somewhere other than the fallback directory. A kind without a line uses fallback.

# Mandatory. Directory for every kind that has no line of its own.
fallback=~/.scratch
# Optional. Directory for chat context summaries.
chat-context-summary=~/.scratch/summaries
# Optional. Directory for work states.
work-state=~/.scratch/work-tracking

# Profile setup template. Copy to profiles/<name>/.env (a local file) and fill in.
# Each key has a comment line: meaning, then the format of the value.
# "Detected" keys are set by the setup skill. "Clone of <url>" keys need that repository cloned first.

# Home directory of this machine. Detected. Native absolute path, no trailing separator: macOS /Users/name, Linux /home/name, Windows C:\Users\name.
HOME_PATH=
# file:// URI of HOME_PATH. Detected. macOS file:///Users/name, Linux file:///home/name, Windows file:///C:/Users/name.
HOME_FILE_URI=
# Local chatpicker clone. Clone of https://github.com/kkacprzykdev/chatpicker.git. Absolute path to the clone root, no trailing separator.
CHAT_PICKER_HOME=
# Local TreeStatus source clone. Clone of https://github.com/kkacprzykdev/treestatus.git. Absolute path to the clone root, no trailing separator.
TREESTATUS_REPO=

# Profile setup template. Copy to profiles/<name>/.env (a local file) and fill in.
# Each key has a comment line: meaning, then the format of the value.

# Home directory of this machine. Absolute path, no trailing slash.
HOME_PATH=/Users/yourname
# file:// form of HOME_PATH. file:// followed by the HOME_PATH value.
HOME_FILE_URI=file:///Users/yourname
# Local chatpicker clone. Absolute path, no trailing slash.
CHAT_PICKER_HOME=/Users/yourname/projects/chatpicker
# Local TreeStatus source clone. Absolute path, no trailing slash.
TREESTATUS_REPO=/Users/yourname/projects/treestatus

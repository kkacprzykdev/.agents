#!/bin/sh
# Guards Core. A commit that concludes a merge passes, because merging main carries Core.
# - In a store with an Upstream store, Core is read-only. Rejects a commit on main, and a commit that stages
#   a Core file on any other branch.
# - In a store that owns its Core, Core is edited on main. Rejects a commit on a profile branch that stages
#   a Core file. A branch is a profile branch when it has its own profiles/<branch>/profile.yaml, so the
#   branch of a Core change worktree passes.
# Then runs the ag tests when a commit changes the ag tool, the git hooks, or artifacts/, which the layout test checks.
# A failing test blocks the commit.

if ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  # The full ref, because --short gives heads/<branch> when a tag has the branch's name.
  branch=$(git symbolic-ref -q HEAD)
  branch=${branch#refs/heads/}
  # Pathspecs, not a grep, because git quotes a path with non-ASCII characters in its output.
  core=$(git -c core.quotePath=false diff --cached --name-only --no-renames -- \
    ':(top,exclude)profiles/' ':(top,exclude)skills/' ':(top,exclude).skill-lock.json')
  if git remote get-url upstream >/dev/null 2>&1; then
    if [ "$branch" = "main" ]; then
      echo "pre-commit: main is the Core branch. Core is read-only in a store with an Upstream store." >&2
      echo "pre-commit: put the change in a profile instead. ag owner <path> names where it goes." >&2
      exit 1
    fi
    if [ -n "$core" ]; then
      echo "pre-commit: these staged files are Core, which is read-only in a store with an Upstream store:" >&2
      echo "$core" | sed 's/^/  /' >&2
      echo "pre-commit: unstage them and put the change in a profile instead. ag owner <path> names where it goes." >&2
      exit 1
    fi
  elif [ -n "$core" ] && [ -n "$branch" ] && git cat-file -e "HEAD:profiles/$branch/profile.yaml" 2>/dev/null; then
    echo "pre-commit: these staged files are Core, which this store edits only on main:" >&2
    echo "$core" | sed 's/^/  /' >&2
    echo "pre-commit: unstage them and make the change on main, in the checkout that ag owner <path> names." >&2
    exit 1
  fi
fi

git diff --cached --name-only | grep -qE '^(sync/|\.githooks/|artifacts/)' || exit 0

root=$(git rev-parse --show-toplevel)
[ -d "$root/sync/test" ] || exit 0

echo "pre-commit: running ag tests" >&2
if ! node --test "$root"/sync/test/*.test.mjs >&2; then
  echo "pre-commit: ag tests failed, commit rejected." >&2
  exit 1
fi
exit 0
